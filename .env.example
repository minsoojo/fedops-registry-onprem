APP_ENV=production
APP_PORT=8012
CORS_ORIGINS=http://127.0.0.1:3000
MONGODB_URI=
MONGODB_DATABASE=fedops-registry
AWS_DEFAULT_REGION=ap-northeast-2
# Registry already uses its own object store; these are example addresses.
AWS_S3_ENDPOINT_URL=http://objects.example.invalid:9000
# Set only if clients cannot use the internal endpoint. The URL is signed at this address.
AWS_S3_PUBLIC_ENDPOINT_URL=https://objects.example.invalid
AWS_S3_LLMS_BUCKET=fedops-llms
AWS_S3_TASKS_BUCKET=fedops-tasks
AWS_S3_GLOBAL_MODEL_BUCKET=fedops-models
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
